# Copy this file to .env and fill in your own keys. Never commit .env (it is in .gitignore).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the default models (DECISIONS.md section 2)
# GEMINI_MODEL=gemini-3.5-flash
# CLAUDE_MODEL=claude-haiku-5-5

# Optional: local record/replay cache for LLM answers: off | record | replay
# LLM_CACHE=off
